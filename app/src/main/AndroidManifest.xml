<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      悬浮面板使用 TYPE_ACCESSIBILITY_OVERLAY，由无障碍服务本身授权，
      因此不需要 SYSTEM_ALERT_WINDOW（"显示在其他应用上层"）权限。
    -->

    <!--
      应用内更新需要这个权限，才能把下载好的 APK 交给系统安装器。
      声明之后用户还要在系统设置里给本应用开启一次「允许安装未知应用」；
      每次安装仍会弹出系统确认框 —— Android 不允许非系统应用静默安装。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Android 11（API 30）起有软件包可见性限制。声明这个 queries 之后才能列出
      有启动图标的应用供用户选择白名单，而不必申请受 Play 严格审查的
      QUERY_ALL_PACKAGES 权限。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">

        <activity
            android:name="com.study.quadtap.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.study.quadtap.QuadTapAccessibilityService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 把缓存里下载好的 APK 以 content:// 形式交给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
